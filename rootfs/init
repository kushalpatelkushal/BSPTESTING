#!/bin/sh
# Runs as PID 1 in the initramfs. Prints "Result:" lines that
# scripts/check-log.sh asserts on, so a headless CI run is a real test.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# An initramfs has no /dev nodes, so the kernel prints
# "Warning: unable to open an initial console" and gives PID 1 no stdout: every
# echo below would vanish into a closed fd while the kernel's own log kept
# flowing to ttyAMA0. Mount devtmpfs (or make the two nodes ourselves -- PID 1 is
# root) and only then point our stdio at the console.
mount -t devtmpfs devtmpfs /dev 2>/dev/null
[ -c /dev/console ] || mknod /dev/console c 5 1 2>/dev/null
[ -c /dev/null ] || mknod /dev/null c 1 3 2>/dev/null
exec >/dev/console 2>&1

echo "Result: kernel-loaded"
echo "Result: uname=$(uname -srm)"

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
echo "Result: mounts=$(grep -c ' /proc\| /sys\| /dev ' /proc/mounts 2>/dev/null)"

DTNODE=/sys/firmware/devicetree/base/hello-demo
if [ -d "$DTNODE" ]; then
	echo "Result: dt-node=found"
	echo "  compatible: $(cat "$DTNODE/compatible" 2>/dev/null)"
else
	echo "Result: dt-node=MISSING"
fi

echo "--- platform devices before insmod ---"
ls /sys/devices/platform | tr '\n' ' '
echo ""

if insmod /lib/modules/hello_demo.ko; then
	echo "Result: insmod=OK"
else
	echo "Result: insmod=FAIL"
fi

echo "--- tail of kernel log ---"
if dmesg 2>/dev/null | tail -n 12; then
	:
else
	echo "(dmesg applet not built; the driver's probe message is still asserted below)"
fi

DEVPATH=$(ls -d /sys/devices/platform/hello-demo* 2>/dev/null | sed -n '1p')
echo "Result: sysfs-path=$DEVPATH"
echo "Result: sysfs-channels=$(cat "$DEVPATH/channels" 2>/dev/null)"
echo "Result: sysfs-model=$(cat "$DEVPATH/model" 2>/dev/null)"
echo "Result: dev-read=$(cat /dev/hello 2>/dev/null)"
echo "Result: dev-read-again=$(cat /dev/hello 2>/dev/null)"

# /sys/module/<name> is the truth; busybox rmmod can exit 0 on failure (see lab 2).
rmmod hello_demo
if [ -d /sys/module/hello_demo ]; then
	echo "Result: rmmod=FAIL"
else
	echo "Result: rmmod=OK"
fi

if [ -e /dev/hello ]; then
	echo "Result: leftover-devnode=yes"
else
	echo "Result: leftover-devnode=no"
fi

###########################################################################
# Lab 2: drivers/labgpio -- a real MMIO + interrupt-controller driver for the
# PL061 GPIO block at 0x09030000. The in-kernel gpio-pl061 is compiled out, so
# until labgpio loads the device exists on the AMBA bus with no driver, and
# gpio-keys (QEMU's power button, PL061 line 3) is stuck waiting for it.
###########################################################################
echo "--- lab 2: PL061 GPIO, MMIO + chained IRQ ---"
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

AMBA=/sys/bus/amba/devices/9030000.pl061
GKEYS=/sys/bus/platform/drivers/gpio-keys/gpio-keys

if [ -e "$AMBA/driver" ]; then
	echo "Result: gpio-pl061-before=bound"
else
	echo "Result: gpio-pl061-before=unbound"
fi
if [ -e "$GKEYS" ]; then
	echo "Result: gpio-keys-before=bound"
else
	echo "Result: gpio-keys-before=waiting"
fi
echo "  devices_deferred: $(cat /sys/kernel/debug/devices_deferred 2>/dev/null | tr '\n' ';')"

if insmod /lib/modules/labgpio.ko; then
	echo "Result: gpio-insmod=OK"
else
	echo "Result: gpio-insmod=FAIL"
fi
sleep 1

CHIP=""
for c in /dev/gpiochip*; do
	[ -c "$c" ] || continue
	if gpiotest "$c" info | grep -q 'label=9030000.pl061'; then
		CHIP=$c
	fi
done
echo "Result: gpio-chip $(gpiotest "$CHIP" info 2>&1)"

# Output path: drive each free line high then low and read it back through
# the data register. Line 3 is skipped: gpio-keys owns it.
for l in 0 1 2; do
	echo "Result: gpio-loop $(gpiotest "$CHIP" loop $l 2>&1)"
done

# Registering a gpiochip triggers a deferred-probe pass; gpio-keys should now
# find its GPIO. If it gave up earlier, ask the bus to probe it again.
how=deferred-probe
if [ ! -e "$GKEYS" ]; then
	echo gpio-keys > /sys/bus/platform/drivers_probe 2>/dev/null
	sleep 1
	how=manual-probe
fi
if [ -e "$GKEYS" ]; then
	echo "Result: gpio-keys=bound via $how"
else
	echo "Result: gpio-keys=unbound"
fi
echo "Result: gpio-line3 $(gpiotest "$CHIP" busy 3 2>&1)"

# Interrupt path. The host watches for the marker and sends QMP
# system_powerdown, which pulses line 3. Count the IRQs gpio-keys receives.
irqcount() {
	awk '/Poweroff/ { s = 0; for (i = 2; i <= NF; i++) { if ($i ~ /^[0-9]+$/) s += $i; else break } print s; exit }' /proc/interrupts
}
before=$(irqcount)
before=${before:-0}
echo "Result: gpio-wait-powerbtn"
now=$before
i=0
while [ "$i" -lt 20 ]; do
	sleep 1
	now=$(irqcount)
	now=${now:-0}
	[ "$now" -gt "$before" ] && break
	i=$((i + 1))
done
if [ "$now" -gt "$before" ]; then
	echo "Result: gpio-irq=fired ($before -> $now)"
else
	echo "Result: gpio-irq=none (no host stimulus within 20s)"
fi
grep Poweroff /proc/interrupts
echo "--- /sys/kernel/debug/labgpio/regs ---"
cat /sys/kernel/debug/labgpio/regs 2>/dev/null

# Module lifetime: a consumer holding a line pins the provider module
# (gpiolib does try_module_get(gc->owner) on request and on IRQ use).
#
# Judge by kernel state, never by rmmod's exit code: busybox's small rmmod
# (CONFIG_MODPROBE_SMALL) prints the error and still exits 0. The first
# version of this lab trusted the exit code and reported "allowed" while the
# kernel had in fact refused.
echo "Result: gpio-refcnt-in-use=$(cat /sys/module/labgpio/refcnt 2>/dev/null)"
rmmod labgpio 2>&1 | sed 's/^/  rmmod says: /'
if [ -d /sys/module/labgpio ]; then
	echo "Result: gpio-rmmod-in-use=refused"
else
	echo "Result: gpio-rmmod-in-use=allowed"
fi
echo gpio-keys > /sys/bus/platform/drivers/gpio-keys/unbind 2>/dev/null
echo "Result: gpio-refcnt-after-unbind=$(cat /sys/module/labgpio/refcnt 2>/dev/null)"
rmmod labgpio
if [ -d /sys/module/labgpio ]; then
	echo "Result: gpio-rmmod=FAIL"
else
	echo "Result: gpio-rmmod=OK"
fi
if [ -n "$CHIP" ] && [ -e "$CHIP" ]; then
	echo "Result: gpio-chip-after-rmmod=present"
else
	echo "Result: gpio-chip-after-rmmod=gone"
fi

echo "Result: lab-complete"
poweroff -f
